API_MODE=demo
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# Defaults resolve from the repository root. Existing catalog is seeded only once.
# CLUB_CONFIG_PATH=../../generated/club/public.json
# CLUB_SEED_PATH=../../generated/club/seed.json
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8788,http://127.0.0.1:8788
# Production credentials stay on the server. Each identity and payment channel is independent.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NATIVE_APP_ID=
WECHAT_NATIVE_APP_SECRET=
WECHAT_PAY_ENABLED=false
WECHAT_NATIVE_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_NATIVE_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_NATIVE_PAY_REFUND_NOTIFY_URL=

# Phone login; details in ../../docs/11-phone-auth.md. No secrets belong in client config.
SMS_PROVIDER=disabled
# Generate once with the command above. Retain with the DB; do not replace on redeploy.
SMS_HASH_SECRET=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_HAS_MINUTES=false
SMS_TRUSTED_PROXY_IPS=
