{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"OpenNI Club public configuration",
  "type":"object","additionalProperties":false,"required":["schemaVersion","brand"],
  "properties":{
    "schemaVersion":{"const":1},
    "brand":{"type":"object","additionalProperties":false,"required":["name","logo"],"properties":{
      "name":{"type":"string","minLength":1,"maxLength":40},
      "logo":{"type":"string","minLength":1,"maxLength":512},
      "shortName":{"type":"string","maxLength":12},
      "tagline":{"type":"string","maxLength":150},
      "description":{"type":"string","maxLength":5000},
      "primaryColor":{"type":"string","pattern":"^#[A-Fa-f0-9]{6}$"},
      "iconBackground":{"type":"string","pattern":"^#[A-Fa-f0-9]{6}$"},
      "notice":{"type":"string","maxLength":500}}},
    "operator":{"type":"object","additionalProperties":false,"properties":{
      "legalEntity":{"type":"string","maxLength":200},"supportContact":{"type":"string","maxLength":200},"city":{"type":"string","maxLength":100}}},
    "legal":{"type":"object","additionalProperties":false,"properties":{
      "privacyText":{"type":"string","maxLength":20000},"termsText":{"type":"string","maxLength":20000}}},
    "distribution":{"type":"object","additionalProperties":false,"properties":{
      "clubId":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,39}$"},
      "androidApplicationId":{"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$"},
      "iosBundleId":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*){2,}$"},
      "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "buildNumber":{"type":"integer","minimum":1,"maximum":2100000000},
      "wechatMiniAppId":{"type":"string","pattern":"^(wx[0-9A-Za-z]{16})?$"},
      "wechatNativeAppId":{"type":"string","pattern":"^(wx[0-9A-Za-z]{16})?$"},
      "universalLink":{"type":"string","maxLength":500},
      "appleTeamId":{"type":"string","pattern":"^([A-Z0-9]{10})?$"}}},
    "endpoints":{"type":"object","additionalProperties":false,"properties":{
      "apiBaseUrl":{"type":"string","maxLength":500},"siteUrl":{"type":"string","maxLength":500}}},
    "initialCatalog":{"type":"object","additionalProperties":false,"properties":{
      "services":{"type":"array","maxItems":100},"players":{"type":"array","maxItems":100},"announcements":{"type":"array","maxItems":100}}}
  }
}
