# Local demo only. Copy to .env and set a random ADMIN_TOKEN before enabling admin.
# Never commit .env. Run Node from repository root so DATA_DIR is predictable.
PORT=8787
HOST=127.0.0.1
API_MODE=demo
DATA_DIR=./data
ADMIN_TOKEN=
# Browser origins: separate multiple origins with commas. No trailing slash.
CORS_ORIGINS=http://localhost:4173,http://localhost:8080

# Public client configuration is not read by the API.
# Flutter: --dart-define=API_BASE_URL=http://localhost:8787/api/v1
# Mini program: apps/miniprogram/utils/config.js
# Do not put WeChat AppSecret/payment keys into a Flutter define or mini program.

# Optional server-side mini program login. Leave empty for local demo.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional native iOS/Android WeChat Open Platform application (different AppID).
WECHAT_NATIVE_APP_ID=
WECHAT_NATIVE_APP_SECRET=
# Actual payment remains explicitly disabled until your merchant setup is verified.
WECHAT_PAY_ENABLED=false
WECHAT_NATIVE_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_KEY_PATH=
# Example routes; replace example.com with your API origin before enabling.
WECHAT_PAY_NOTIFY_URL=
# https://api.example.com/api/v1/payments/wechat/notify
WECHAT_NATIVE_PAY_NOTIFY_URL=
# https://api.example.com/api/v1/payments/wechat-app/notify
WECHAT_PAY_REFUND_NOTIFY_URL=
# https://api.example.com/api/v1/payments/wechat/refund-notify
WECHAT_NATIVE_PAY_REFUND_NOTIFY_URL=
# https://api.example.com/api/v1/payments/wechat-app/refund-notify
