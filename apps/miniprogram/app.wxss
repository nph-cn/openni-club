.hero-banner{height:342rpx;border-radius:24rpx}.hero-shade{background:linear-gradient(0deg,rgba(7,13,21,.76),rgba(7,13,21,0) 85%)}
.hero-copy{left:28rpx;right:28rpx;bottom:34rpx;font-size:42rpx;font-weight:550}.hero-action{font-size:26rpx;padding:10rpx 16rpx;border-radius:26rpx;background:rgba(255,255,255,.16);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
