/* 统一小程序实色内容与导航控件；不模拟原生 Apple Liquid Glass。 */
page{background:#F4F5F7;color:#222831;font-size:32rpx;line-height:1.55}
.page{--muted:#606B79;--line:#DFE4EB;--shadow:0 8rpx 26rpx rgba(25,38,58,.045);padding-top:28rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}
.title{font-size:46rpx;font-weight:600;line-height:1.32;margin-bottom:32rpx;word-break:break-word}
.section-title{font-size:38rpx;font-weight:600;line-height:1.4;margin:40rpx 0 22rpx}.section-head{gap:16rpx}.section-head .section-title{flex:1;min-width:0}
.service-heading{font-size:36rpx;line-height:1.45;font-weight:600}.body-copy,.service-description{font-size:32rpx;color:#414C5B;line-height:1.75}
.card{background:#fff;border:1rpx solid #E4E8EE;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:none}
.card>.field-label:first-child{margin-top:0}.card>.menu-row:first-child{padding-top:12rpx}.card>.menu-row:last-child{padding-bottom:12rpx}
.row{gap:20rpx}.between>.grow{min-width:0}.strong{font-weight:600}.small{font-size:28rpx;line-height:1.65}.tiny,.label{font-size:26rpx;line-height:1.6;color:#616C7B}
.price{font-size:44rpx;font-weight:600;letter-spacing:-.5rpx;font-variant-numeric:tabular-nums;color:#1D232B}.price text{font-size:28rpx;font-weight:400;letter-spacing:0}.summary-number{font-size:46rpx}
.button{min-height:100rpx;border-radius:20rpx;padding:24rpx;font-size:32rpx;font-weight:550;box-shadow:0 4rpx 12rpx rgba(25,38,58,.08);transition:background-color .16s ease,transform .16s ease}
.button.secondary{background:#E9EDF3;color:#2D3848;box-shadow:none}.button.danger{background:#F8EDEA;color:#963D33;box-shadow:none}
button[disabled],button[disabled]:active{opacity:1;transform:none}.button[disabled],button.button[disabled]{background:#E1E6ED!important;color:#647081!important;box-shadow:none}
button:active{opacity:1;transform:scale(.987)}button.text-button:active{background:transparent}.link:active{color:#111B29}
.button-row{gap:16rpx;flex-wrap:wrap}.button-row .button{min-width:200rpx}.link{min-height:88rpx;font-size:30rpx;justify-content:center}
.field,.search-input{min-height:100rpx;border:2rpx solid #D4DAE3;border-radius:18rpx;background:#fff;color:#202A36;font-size:32rpx;padding:22rpx 24rpx;box-shadow:none}
.field:focus,.search-input:focus{border-color:#73839A}.field-label{font-size:30rpx;font-weight:550;margin:28rpx 0 14rpx;color:#344051}.field.textarea{height:220rpx;line-height:1.7}.field-row{gap:18rpx}
.search-input{margin:4rpx 0 26rpx}.chips{margin:24rpx 0 30rpx;padding:8rpx;background:#E8ECF1;border-radius:20rpx;box-sizing:border-box}
.chip{background:transparent;color:#5B6574;border-radius:15rpx;min-height:84rpx;padding:16rpx 24rpx;margin-right:6rpx;font-size:30rpx}
.chip.active{background:#fff;color:var(--primary);font-weight:600;box-shadow:0 2rpx 8rpx rgba(24,38,58,.1)}
.slot-grid{gap:16rpx}.slot-grid .chip{background:#fff;border:2rpx solid #DEE4EC;border-radius:16rpx;min-height:92rpx;padding:18rpx 22rpx;white-space:normal}.slot-grid .chip.active{background:var(--primary);border-color:var(--primary);color:#fff;box-shadow:none}.slot-grid .chip[disabled]{background:#E9EDF2;color:#717B89;border-color:#E0E5EC}
.rating-row{gap:8rpx}.rating-row .chip{background:#EDF0F5;border-radius:14rpx;margin:0;font-size:28rpx}.rating-row .chip.active{background:var(--primary);color:#fff}
.tag,.pill{border-radius:10rpx;padding:7rpx 14rpx;background:#EDF0F5;color:#536071;line-height:1.5}.status{padding:8rpx 16rpx;border-radius:10rpx;font-size:26rpx;max-width:100%;background:#EAF0F7;color:#465E7D;line-height:1.45}.status.completed{background:#E8F1EB;color:#35654D}.status.cancelled{background:#EDF0F4;color:#68717D}
.avatar,.member-photo{border-radius:24rpx;background:#E8ECF2}.member-photo{width:144rpx;height:164rpx}.member-portrait{border-radius:24rpx;box-shadow:none}.member-tile .strong{font-size:34rpx}
.profile-header{gap:24rpx;margin:4rpx 0 34rpx}.profile-header>view:last-child{min-width:0;flex:1}.profile-header .title{font-size:42rpx;line-height:1.35;overflow-wrap:break-word}
.menu-row{min-height:112rpx;padding:26rpx 0;border-bottom:1rpx solid #E8ECF1;gap:20rpx}.menu-row>text:first-child{flex:1;min-width:0}.menu-row>text:last-child{font-size:28rpx;color:#636F7E;text-align:right}.menu-row:active{background:#F6F8FA}
.notice,.banner{border:1rpx solid #DEE5ED;background:#EEF2F6;color:#48586C;border-radius:20rpx;padding:24rpx;box-shadow:none}.notice{font-size:28rpx;line-height:1.7}.notice-dot{background:#5A6F8A;width:12rpx;height:12rpx;margin-bottom:3rpx}
.form-error{color:#9D4035;background:#FAEFEC;border-left:4rpx solid #C48276;border-radius:12rpx;padding:20rpx 24rpx;font-size:30rpx;line-height:1.65}.form-error:empty{display:none}.danger-text{color:#9D4035}
.divider{background:#E6EAF0;margin:26rpx 0}.order-line{gap:24rpx;padding:18rpx 0;font-size:30rpx;line-height:1.65}.order-line>text:first-child{flex-shrink:0}.order-line>text:last-child{min-width:0}.order-state{padding:6rpx 0 28rpx}.order-state .title{margin-bottom:12rpx}
.timeline{padding:24rpx 28rpx 0;background:#fff;border:1rpx solid #E4E8EE;border-radius:24rpx}.timeline-item{padding-bottom:34rpx;gap:24rpx}.timeline-item:last-child{padding-bottom:28rpx}.timeline-dot{width:14rpx;height:14rpx;margin-top:17rpx;box-shadow:0 0 0 7rpx #EEF1F5}.timeline-item:not(:last-child)::after{left:6rpx;top:36rpx;bottom:0;background:#E0E5ED}.timeline .grow{font-size:30rpx;line-height:1.65}
.fact-grid{padding:26rpx;background:#fff;border:1rpx solid #E4E8EE;border-radius:22rpx;margin-top:28rpx;gap:24rpx}.fact-grid>view{width:calc(50% - 12rpx)}.flow-step{padding:20rpx 0;font-size:30rpx;color:#475464;border-color:#E0E6ED;line-height:1.7}
.service-card-photo{height:300rpx;border-radius:20rpx;box-shadow:none;background:#E7ECF2;display:block}.service-detail-page>.service-card-photo{height:350rpx;margin-bottom:32rpx;border-radius:24rpx}
.service-detail-page{padding-bottom:calc(210rpx + env(safe-area-inset-bottom))}.service-bookbar{padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.85);background:rgba(248,250,253,.94);backdrop-filter:blur(24px) saturate(145%);-webkit-backdrop-filter:blur(24px) saturate(145%);box-shadow:0 -8rpx 28rpx rgba(25,38,58,.07)}
.home-page{padding-top:10rpx}.home-toolbar{margin:6rpx 0 24rpx;gap:16rpx}.home-heading{font-size:44rpx;font-weight:600}.login-pill{background:rgba(255,255,255,.9);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border:1rpx solid #fff;box-shadow:0 7rpx 24rpx rgba(25,38,58,.07)}
.hero-banners,.hero-banner{height:342rpx;border-radius:26rpx}.hero-banners{box-shadow:0 7rpx 24rpx rgba(25,38,58,.07)}.hero-copy{left:28rpx;right:28rpx;gap:16rpx;bottom:34rpx}.hero-copy>text:first-child{flex:1;min-width:0;line-height:1.35;font-size:40rpx}.hero-action{flex-shrink:0;font-size:26rpx;background:rgba(255,255,255,.18);border:1rpx solid rgba(255,255,255,.18)}
.game-nav{gap:10rpx;padding:30rpx 0 18rpx}.game-nav-item{font-size:28rpx;line-height:1.5;min-height:144rpx}.game-nav-item image{width:88rpx;height:88rpx;border-radius:20rpx;box-shadow:0 3rpx 10rpx rgba(25,38,58,.08)}
.home-page .section-head{margin:26rpx 0 14rpx}.home-service-list{border:1rpx solid #E4E8EE;border-radius:24rpx;box-shadow:none;padding:0 22rpx}.home-service-list .service-heading{font-size:30rpx;line-height:1.45}.home-service-list .service-facts{font-size:26rpx;line-height:1.6}.home-service-list .price{font-size:38rpx}.home-service-list .service-list-item{padding:24rpx 0;border-color:#E7EBF1}.home-service-list .row{gap:18rpx}.service-thumb{height:130rpx;width:112rpx;border-radius:16rpx;background:#E7ECF2}
.state,.empty{padding:64rpx 26rpx;line-height:1.7;color:#616F80}.state-title,.empty-title{font-size:38rpx;font-weight:600;color:#2B3747}.state-message{font-size:30rpx;max-width:570rpx}.empty{background:#fff;border:1rpx solid #E4E8EE;border-radius:24rpx;margin-top:20rpx;font-size:32rpx}.state-symbol{border-radius:30rpx;background:#E7EDF4}.empty:before{content:"";display:block;width:68rpx;height:52rpx;border:3rpx solid #8493A6;border-radius:12rpx;margin:0 auto 30rpx;background:linear-gradient(0deg,#EDF1F6 40%,transparent 40%)}
.state .button,.empty .button{margin-top:26rpx;max-width:420rpx}.earnings-summary{background:#fff;border:1rpx solid #E4E8EE;border-radius:24rpx;padding:30rpx}.earnings-total{font-size:68rpx;font-weight:600;margin:8rpx 0 30rpx}.earnings-summary>.row{flex-wrap:wrap;font-size:28rpx;gap:12rpx}.summary-grid .card{min-width:0}
.notifications-page .card>.row{align-items:flex-start;flex-wrap:wrap;gap:10rpx}.notifications-page .strong{flex:1;min-width:240rpx}.notifications-page .message-body{font-size:30rpx}.member-page>.row .title{flex:1;min-width:0;font-size:42rpx}.orders-page .service-heading{margin-top:20rpx}.orders-page .card .price{font-size:40rpx}.orders-page .card .link{font-size:28rpx;min-height:60rpx}.orders-page .card>.row:last-child{flex-wrap:wrap;gap:12rpx}
.auth-page{padding-top:48rpx}.auth-title{font-size:56rpx;line-height:1.35;font-weight:600}.auth-phone-field,.code-input{background:#fff;border:2rpx solid #D5DDE7;box-shadow:none;border-radius:22rpx}.code-input.invalid{border-color:#C1786B}.auth-phone-field:focus-within{border-color:#73839A}.auth-brand{margin-bottom:56rpx}.auth-back{color:#4E6078}.code-input{letter-spacing:18rpx}.input-placeholder,.code-placeholder{color:#778190}.test-code{border:1rpx solid #DCE3ED;background:#EBF0F6}.auth-consent{font-size:26rpx}.auth-consent button{font-size:26rpx}
.skeleton{background:#E3E8EF}.skeleton-home .home-service-list{box-shadow:none}.skeleton-home .skeleton-thumb{height:130rpx;border-radius:16rpx}.skeleton-home-hero{border-radius:26rpx}
@media(prefers-reduced-motion:reduce){button,.button,.chip{transition:none}button:active{transform:none}.skeleton:after{animation:none}}
@media(prefers-reduced-transparency:reduce){.service-bookbar,.login-pill{background:#F9FAFC;backdrop-filter:none;-webkit-backdrop-filter:none}.hero-action{background:#303C4C;backdrop-filter:none;-webkit-backdrop-filter:none}}
@media(prefers-contrast:more){.muted,.small,.label,.service-facts{color:#465363}.field,.search-input{border-color:#7B899C}.card,.home-service-list{border-color:#ABB6C5}}
