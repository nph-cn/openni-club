.offline-symbol:before{content:"";position:absolute;width:44rpx;height:44rpx;border:3rpx solid #647387;border-radius:50%;left:28rpx;top:28rpx}.offline-symbol:after{content:"";position:absolute;width:50rpx;height:3rpx;background:#647387;left:27rpx;top:51rpx;transform:rotate(-45deg)}
