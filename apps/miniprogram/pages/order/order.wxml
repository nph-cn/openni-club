<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}">
<view class="order-state"><view class="title">{{order.statusLabel}}</view><view wx:if="{{order.acceptBy}}">接单截止 {{order.acceptTime}}</view></view>
<view class="card"><view class="service-heading">{{order.serviceTitle}}</view><view wx:if="{{order.serviceSnapshot.variantTitle}}" class="muted">{{order.serviceSnapshot.variantTitle}}</view><view class="order-line"><text class="muted">预约时间</text><text>{{order.time}}</text></view><view class="order-line"><text class="muted">服务时长</text><text>{{order.durationMinutes}} 分钟</text></view><view class="order-line"><text class="muted">联系方式</text><text selectable>{{order.contact}}</text></view><view wx:if="{{order.note}}" class="order-line"><text class="muted">客户要求</text><text>{{order.note}}</text></view><view class="divider"></view><view class="row between"><text>{{memberView?'本单预计收入':'服务费用'}}</text><text class="price">¥{{memberView?order.income:order.price}}</text></view><view class="small muted">{{order.paymentLabel}}</view></view>
<view wx:if="{{order.delivery}}" class="card"><view class="service-heading">交付记录</view><view class="body-copy">{{order.delivery.summary}}</view><text wx:if="{{order.delivery.evidenceUrl}}" selectable class="small muted">{{order.delivery.evidenceUrl}}</text></view>
<view wx:if="{{order.dispute}}" class="notice"><view class="strong">售后 · {{order.dispute.status==='open'?'待处理':'已处理'}}</view><view>{{order.dispute.reason}}</view><view wx:if="{{order.dispute.resolution}}">{{order.dispute.resolution}}</view></view>
<block wx:if="{{memberView}}"><view wx:if="{{order.fulfillmentStatus==='awaiting_acceptance'}}" class="button-row"><button class="button secondary" bindtap="openAction" data-action="decline">无法接单</button><button class="button" bindtap="direct" data-action="accept" loading="{{saving}}" disabled="{{saving}}">确认接单</button></view><button wx:if="{{order.fulfillmentStatus==='scheduled'}}" class="button" bindtap="direct" data-action="start" loading="{{saving}}" disabled="{{saving}}">开始服务</button><button wx:if="{{order.fulfillmentStatus==='in_progress'}}" class="button" bindtap="openAction" data-action="submit">提交交付记录</button></block>
<block wx:else><button wx:if="{{order.canConfirm}}" class="button" bindtap="openAction" data-action="confirm">确认服务完成</button><button wx:if="{{order.canPay}}" class="button" loading="{{paying}}" disabled="{{paying}}" bindtap="pay">微信支付 ¥{{order.price}}</button><view class="button-row"><button wx:if="{{order.canCancel}}" class="button secondary" bindtap="cancel" disabled="{{cancelling}}" loading="{{cancelling}}">取消订单</button><button wx:if="{{order.canDispute}}" class="button secondary" bindtap="openAction" data-action="dispute">申请售后</button></view></block>
<view wx:if="{{action}}" class="card action-form"><view class="service-heading">{{action==='submit'?'交付记录':action==='confirm'?'确认服务完成':action==='dispute'?'申请售后':'无法接单'}}</view><view wx:if="{{action==='confirm'}}" class="rating-row"><button wx:for="{{ratings}}" wx:key="*this" class="chip {{rating===item?'active':''}}" bindtap="rate" data-value="{{item}}">{{item}} 分</button></view><textarea class="field textarea" value="{{actionText}}" bindinput="change" data-field="actionText" maxlength="{{action==='submit'?3000:action==='decline'?500:1000}}" placeholder="{{action==='submit'?'本次服务内容与完成情况':action==='confirm'?'评价（选填）':'填写原因，方便俱乐部处理'}}"/><input wx:if="{{action==='submit'}}" class="field page-bottom" value="{{evidenceUrl}}" bindinput="change" data-field="evidenceUrl" placeholder="交付凭据 HTTPS 链接（选填）" maxlength="2048"/><view class="button-row"><button class="button secondary" bindtap="closeAction">返回</button><button class="button" bindtap="submitAction" disabled="{{saving}}" loading="{{saving}}">{{action==='confirm'?'确认完成':'提交'}}</button></view></view>
<view wx:if="{{actionError}}" class="form-error">{{actionError}}</view><view wx:if="{{paymentMessage}}" class="notice">{{paymentMessage}}</view><button wx:if="{{wechatLinkRequired}}" class="button page-bottom" bindtap="linkAndPay" disabled="{{linking}}" loading="{{linking}}">关联微信并继续支付</button>
<view class="section-title">订单进度</view><view class="timeline"><view wx:for="{{order.events}}" wx:key="id" class="timeline-item"><view class="timeline-dot"></view><view class="grow"><view>{{item.message}}</view><view class="small muted">{{item.actor.name}} · {{item.time}}</view></view></view></view>
<view wx:if="{{order.serviceSnapshot.rules.length}}" class="card"><view class="service-heading">下单时服务约定</view><view wx:for="{{order.serviceSnapshot.rules}}" wx:key="*this" class="flow-step">{{item}}</view></view><view class="order-id muted">{{order.id}}</view></block></view>
