<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">俱乐部公告</view><view style="height:28rpx"></view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><view wx:for="{{announcements}}" wx:key="id" class="card"><view class="label">{{item.date}}</view><view class="service-heading">{{item.title}}</view><view wx:if="{{expanded===item.id}}" class="body-copy">{{item.body}}</view><button class="link" bindtap="toggle" data-id="{{item.id}}">{{expanded===item.id?'收起公告 ↑':'阅读全文 →'}}</button></view><view wx:if="{{!announcements.length}}" class="empty">暂无公告，过会儿再来看看。</view></block></view>
