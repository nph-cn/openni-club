<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">服务</view><input class="search-input" placeholder="搜索游戏或服务" value="{{query}}" bindinput="search" aria-label="搜索游戏或服务"/><scroll-view class="chips" scroll-x><button wx:for="{{categories}}" wx:key="*this" class="chip {{active===item?'active':''}}" data-value="{{item}}" bindtap="choose">{{item}}</button></scroll-view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><button wx:for="{{services}}" wx:key="id" class="text-button" bindtap="navigate" data-url="/pages/service/service?id={{item.id}}"><view class="card"><image wx:if="{{item.coverUrl}}" class="service-card-photo" mode="aspectFill" src="{{item.coverUrl}}"/><view class="service-heading">{{item.title}}</view><view class="service-facts">{{item.facts}}</view><view class="row between"><text>{{item.durationMinutes}} 分钟 · {{item.typeLabel}}</text><text class="price">¥{{item.fromPrice}}<text>{{item.variants.length?' 起':' / '+item.unitLabel}}</text></text></view></view></button><view wx:if="{{!services.length}}" class="empty">暂无匹配服务</view></block></view>
