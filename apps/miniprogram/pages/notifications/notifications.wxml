<import src="../../templates/common.wxml"/>
<view class="page notifications-page" style="{{themeStyle}}"><view class="title">消息</view><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><button wx:for="{{notifications}}" wx:key="id" class="text-button" bindtap="open" data-id="{{item.id}}"><view class="card"><view class="row between"><view class="strong"><text wx:if="{{!item.readAt}}" class="notice-dot"></text>{{item.title}}</view><text class="small muted">{{item.time}}</text></view><view class="body-copy message-body">{{item.body}}</view></view></button><view wx:if="{{!notifications.length}}" class="empty">暂无新消息</view></block></view>
