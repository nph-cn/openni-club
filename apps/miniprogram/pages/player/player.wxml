<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><view class="row profile-header"><image wx:if="{{player.image}}" class="member-photo" mode="aspectFill" src="{{player.image}}"/><view wx:else class="avatar large">{{player.initials}}</view><view><view class="title">{{player.name}}</view><text>{{player.role}}</text></view></view><view class="tag-row"><text wx:for="{{player.games}}" wx:key="*this" class="tag">{{item}}</text></view><view class="body-copy">{{player.bio}}</view><view class="section-title">今日可约</view><view class="slot-grid"><text wx:for="{{slots}}" wx:key="startAt" class="pill">{{item.label}}</text></view><view wx:if="{{availabilityError}}" class="form-error">{{availabilityError}}</view><view wx:elif="{{!slots.length}}" class="muted">今日暂无开放时段</view><view class="section-title">预约服务</view><view wx:for="{{services}}" wx:key="id" class="card"><view class="service-heading">{{item.title}}</view><view class="row between"><text>{{item.durationMinutes}} 分钟</text><text class="price">¥{{item.fromPrice}}<text>{{item.variants.length?' 起':' / '+item.unitLabel}}</text></text></view><button class="button secondary page-bottom" bindtap="navigate" data-url="/pages/booking/booking?serviceId={{item.id}}&playerId={{player.id}}">选择规格与时间</button></view></block><template is="demo" data="{{demo}}"/></view>
