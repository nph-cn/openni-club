<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><view class="row profile-header"><view class="avatar large">{{me.user.name?me.user.name[0]:'我'}}</view><view><view class="title">{{me.user.name}}</view><text class="muted">{{me.role==='member'?'俱乐部成员':'俱乐部客户'}}</text></view></view><view class="profile-stats"><view class="stat-cell"><view class="stat-num">{{total}}</view><view class="stat-label">我的预约</view></view><view class="stat-cell"><view class="stat-num">{{pending}}</view><view class="stat-label">进行中</view></view><view class="stat-cell"><view class="stat-num">{{memberCount}}</view><view class="stat-label">俱乐部成员</view></view></view><view class="card"><view class="menu-row" bindtap="tab" data-url="/pages/orders/orders"><text>我的订单</text><text>{{pending}} 单进行中</text></view><view class="menu-row" bindtap="navigate" data-url="/pages/notifications/notifications"><text>消息</text><text>{{unread?unread+' 条未读':'查看'}}</text></view><view wx:if="{{me.role==='member'}}" class="menu-row" bindtap="navigate" data-url="/pages/member/member"><text class="strong">成员工作台</text><text>进入</text></view><view class="menu-row" bindtap="navigate" data-url="/pages/settings/settings"><text>设置与隐私</text><text>查看</text></view></view><view wx:if="{{!demo&&me.role!=='member'}}" class="card"><view class="service-heading">加入俱乐部成员</view><input class="field" value="{{invitation}}" bindinput="change" placeholder="输入运营提供的邀请码" maxlength="128"/><button class="button page-bottom" bindtap="join" disabled="{{joining}}" loading="{{joining}}">绑定成员身份</button></view><block wx:if="{{demo}}"><view class="section-title">演示身份</view><view class="card"><view class="menu-row" bindtap="switchRole" data-role="customer"><text>客户</text><text>{{me.role==='customer'?'当前身份':'切换'}}</text></view><view wx:for="{{players}}" wx:key="id" class="menu-row" bindtap="switchRole" data-role="member" data-id="{{item.id}}"><text>成员 · {{item.name}}</text><text>{{me.playerId===item.id?'当前身份':'进入工作台'}}</text></view></view></block><view wx:if="{{joinMessage}}" class="form-error">{{joinMessage}}</view></block></view>
