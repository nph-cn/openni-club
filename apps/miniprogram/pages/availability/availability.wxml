<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">可接时段</view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><view class="card"><view class="field-label">日期</view><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="change" data-field="date"><view class="field">{{date}}</view></picker><view class="field-row"><view><view class="field-label">开始</view><picker mode="time" value="{{start}}" bindchange="change" data-field="start"><view class="field">{{start}}</view></picker></view><view><view class="field-label">结束</view><picker mode="time" value="{{end}}" bindchange="change" data-field="end"><view class="field">{{end}}</view></picker></view></view><button class="button page-bottom" bindtap="add" loading="{{saving}}" disabled="{{saving}}">添加时段</button></view><view wx:if="{{message}}" class="notice">{{message}}</view><view class="section-title">已开放 · 北京时间</view><view class="card"><view wx:for="{{slots}}" wx:key="startAt" class="menu-row"><text class="grow">{{item.label}}</text><button class="link danger-text" bindtap="remove" data-index="{{index}}" disabled="{{saving}}">移除</button></view><view wx:if="{{!slots.length}}" class="muted">尚未开放可接时段</view></view><view class="small muted">已被预约的时段需先处理订单，不能直接移除。</view></block></view>
