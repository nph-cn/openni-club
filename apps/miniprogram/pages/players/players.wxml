<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">俱乐部成员</view><input class="search-input" placeholder="搜索成员或游戏" bindinput="search" value="{{query}}" aria-label="搜索成员"/><view class="page-bottom"></view><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><button wx:for="{{players}}" wx:key="id" class="text-button" bindtap="navigate" data-url="/pages/player/player?id={{item.id}}"><view class="card"><view class="row"><image wx:if="{{item.image}}" class="member-photo" src="{{item.image}}" mode="aspectFill"/><view wx:else class="avatar large">{{item.initials}}</view><view class="grow"><view class="service-heading">{{item.name}}</view><view>{{item.role}}</view><view class="small muted">{{item.games}}</view></view></view><view class="tag-row"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view></button><view wx:if="{{!players.length}}" class="empty">没有匹配的成员</view></block></view>
