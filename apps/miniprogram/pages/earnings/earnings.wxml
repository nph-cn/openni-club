<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">收入明细</view><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><view class="earnings-summary"><view><text class="muted">待结算</text><view class="earnings-total">¥{{totals.available}}</view></view><view class="row between"><text>待确认 / 冻结 ¥{{totals.held}}</text><text>已记录 ¥{{totals.settled}}</text></view></view><scroll-view class="chips" scroll-x><button wx:for="{{tabs}}" wx:key="id" class="chip {{active===item.id?'active':''}}" bindtap="choose" data-id="{{item.id}}">{{item.name}}</button></scroll-view><view wx:for="{{entries}}" wx:key="id" class="card"><view class="row between"><text class="status">{{item.label}}</text><text class="price">¥{{item.amount}}</text></view><view class="order-line"><text class="muted">服务费</text><text>¥{{item.gross}}</text></view><view class="order-line"><text class="muted">俱乐部分成</text><text>¥{{item.club}}</text></view><view class="small muted">{{item.time}}</view><button class="link" bindtap="navigate" data-url="/pages/order/order?id={{item.orderId}}&member=1">查看订单</button></view><view wx:if="{{!entries.length}}" class="empty">暂无此类收入</view><block wx:if="{{settlements.length}}"><view class="section-title">结算凭据</view><view wx:for="{{settlements}}" wx:key="id" class="card"><view class="row between"><text class="strong">{{item.paymentReference}}</text><text>¥{{item.amount}}</text></view><view class="small muted">{{item.time}}</view><view wx:if="{{item.note}}">{{item.note}}</view></view></block><view class="notice">凭据由运营手动记录，请核对实际收款。本系统不自动转账。</view></block></view>
