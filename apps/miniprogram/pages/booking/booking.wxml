<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><view class="title">确认预约</view><view class="card"><view class="service-heading">{{service.title}}</view><view>{{service.variantTitle||service.facts}}</view><view class="row between"><text>{{service.durationMinutes}} 分钟</text><text class="price">¥{{service.price}}</text></view></view><view wx:if="{{variants.length}}" class="slot-grid"><button wx:for="{{variants}}" wx:key="id" class="chip {{variantId===item.id?'active':''}}" bindtap="chooseVariant" data-id="{{item.id}}">{{item.title}}</button></view><view class="card"><view class="field-label">服务成员</view><picker range="{{players}}" range-key="name" value="{{playerIndex}}" bindchange="choosePlayer"><view class="field">{{players[playerIndex].name}}</view></picker><view class="field-label">预约日期 · 北京时间</view><picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="change" data-field="date"><view class="field">{{date}}</view></picker><block wx:if="{{players[playerIndex].id}}"><view class="field-label">成员开放时段</view><view wx:if="{{slotsLoading}}" class="muted">正在查询时段</view><view wx:if="{{slotError}}" class="form-error">{{slotError}}</view><view class="slot-grid"><button wx:for="{{slots}}" wx:key="startAt" class="chip {{time===item.label?'active':''}}" disabled="{{!item.available}}" bindtap="chooseSlot" data-time="{{item.label}}">{{item.label}}{{item.busy?' 已约':''}}</button></view><view wx:if="{{!slotsLoading&&!slots.length&&!slotError}}" class="muted">当天暂无开放时段，可更换日期或由俱乐部安排。</view></block><block wx:else><view class="field-label">期望开始时间</view><picker mode="time" value="{{time}}" bindchange="change" data-field="time"><view class="field">{{time}}</view></picker></block><view class="field-label">联系方式</view><input class="field" placeholder="{{demo?'演示请填虚构联系方式':'微信号或手机号'}}" maxlength="120" value="{{contact}}" data-field="contact" bindinput="change"/><view class="field-label">补充要求</view><textarea class="field textarea" placeholder="地图、位置或沟通偏好（选填）" maxlength="500" value="{{note}}" data-field="note" bindinput="change"/></view><view wx:if="{{service.rules.length}}" class="section-title">服务约定</view><view wx:for="{{service.rules}}" wx:key="*this" class="flow-step">{{item}}</view><view wx:if="{{submitError}}" class="form-error">{{submitError}}</view><button class="button page-bottom" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{demo?'提交演示订单':'提交订单'}} · ¥{{service.price}}</button></block><template is="demo" data="{{demo}}"/></view>
