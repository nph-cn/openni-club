<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><view class="title">我的订单</view><view class="quick-grid"><button class="quick-cell {{active==='pay'?'on':''}}" bindtap="choose" data-id="pay"><view class="quick-num">{{counts.pay}}</view><view class="quick-label">待付款</view></button><button class="quick-cell {{active==='waiting'?'on':''}}" bindtap="choose" data-id="waiting"><view class="quick-num">{{counts.waiting}}</view><view class="quick-label">待接单</view></button><button class="quick-cell {{active==='active'?'on':''}}" bindtap="choose" data-id="active"><view class="quick-num">{{counts.active}}</view><view class="quick-label">服务中</view></button><button class="quick-cell {{active==='done'?'on':''}}" bindtap="choose" data-id="done"><view class="quick-num">{{counts.done}}</view><view class="quick-label">已结束</view></button></view><scroll-view class="chips" scroll-x><button wx:for="{{tabs}}" wx:key="id" class="chip {{active===item.id?'active':''}}" bindtap="choose" data-id="{{item.id}}">{{item.name}}</button></scroll-view><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><button wx:for="{{orders}}" wx:key="id" class="text-button" bindtap="navigate" data-url="/pages/order/order?id={{item.id}}"><view class="card"><view class="row between"><text class="label">{{item.demo?'模拟预约':'俱乐部预约'}}</text><text class="status {{item.status}}">{{item.statusLabel}}</text></view><view class="service-heading">{{item.serviceTitle}}</view><view class="small muted">{{item.time}}</view><view class="divider"></view><view class="row between"><view class="price"><text>¥</text>{{item.price}}<text> · {{item.paymentLabel}}</text></view><text class="link">查看详情 →</text></view></view></button><view wx:if="{{!orders.length}}" class="empty"><view class="empty-title">这里还没有预约</view><button class="button" bindtap="tab" data-url="/pages/services/services">去发现服务</button></view></block></view>
