<import src="../../templates/common.wxml"/>
<view class="page home-page" style="{{themeStyle}}"><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><view class="home-toolbar"><view class="home-heading">游戏服务</view><button wx:if="{{!signedIn}}" class="login-pill" bindtap="login">登录</button><button wx:else class="login-pill" bindtap="tab" data-url="/pages/profile/profile">我的账号</button></view><swiper wx:if="{{banners.length}}" class="hero-banners" indicator-dots="{{banners.length>1}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#fff" circular><swiper-item wx:for="{{banners}}" wx:key="id"><button class="text-button hero-banner" data-id="{{item.id}}" bindtap="openBanner"><image src="{{item.imageUrl}}" mode="aspectFill"/><view class="hero-shade"/><view class="hero-copy"><text>{{item.title}}</text><text class="hero-action">查看服务</text></view></button></swiper-item></swiper><scroll-view class="game-nav" scroll-x enhanced show-scrollbar="{{false}}"><button wx:for="{{games}}" wx:key="name" class="game-nav-item" data-game="{{item.name}}" bindtap="chooseGame"><image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFill"/><view wx:else class="game-icon-fallback">{{item.name}}</view><text>{{item.name}}</text></button></scroll-view><button wx:if="{{activeOrder}}" class="text-button" bindtap="navigate" data-url="/pages/order/order?id={{activeOrder.id}}"><view class="banner"><view class="row between"><text class="strong">{{activeOrder.statusLabel}}</text><text class="small">{{activeOrder.time}}</text></view><view>{{activeOrder.serviceTitle}}</view></view></button><view class="section-head"><view class="section-title">服务推荐</view><button class="link" bindtap="tab" data-url="/pages/services/services">全部服务</button></view><view class="home-service-list"><button wx:for="{{services}}" wx:key="id" class="text-button service-list-item" bindtap="navigate" data-url="/pages/service/service?id={{item.id}}"><view class="row between"><image wx:if="{{item.coverUrl}}" class="service-thumb" src="{{item.coverUrl}}" mode="aspectFill"/><view class="grow"><view class="service-heading">{{item.title}}</view><view wx:if="{{item.description}}" class="service-desc">{{item.description}}</view><view class="service-facts">{{item.platformLabel}} · {{item.durationMinutes}}分钟 · {{item.teamSize||1}}位成员</view></view><text class="price">¥{{item.fromPrice}}<text>{{item.variants.length?' 起':'/'+item.unitLabel}}</text></text></view></button></view><view class="section-head"><view class="section-title">俱乐部成员</view><button class="link" bindtap="navigate" data-url="/pages/players/players">全部成员</button></view><view class="member-grid"><button wx:for="{{players}}" wx:key="id" class="text-button member-tile" bindtap="navigate" data-url="/pages/player/player?id={{item.id}}"><image wx:if="{{item.image}}" class="member-portrait" src="{{item.image}}" mode="aspectFill"/><view wx:else class="member-portrait member-initial">{{item.initials}}</view><view class="strong">{{item.name}}</view><view class="small muted">{{item.role}}</view></button></view><view class="menu-row section-link" bindtap="navigate" data-url="/pages/announcements/announcements"><text>俱乐部公告</text><text class="muted">查看</text></view></block></view>
