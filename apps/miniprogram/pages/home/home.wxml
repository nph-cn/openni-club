<import src="../../templates/common.wxml"/>
<view class="page home-page" style="{{themeStyle}}"><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><button wx:if="{{activeOrder}}" class="text-button" bindtap="navigate" data-url="/pages/order/order?id={{activeOrder.id}}"><view class="banner"><view class="row between"><text class="strong">{{activeOrder.statusLabel}}</text><text class="small">{{activeOrder.time}}</text></view><view>{{activeOrder.serviceTitle}}</view></view></button><view class="section-head"><view class="section-title">热门服务</view><button class="link" bindtap="tab" data-url="/pages/services/services">全部服务</button></view><view class="home-service-list"><button wx:for="{{services}}" wx:key="id" class="text-button service-list-item" bindtap="navigate" data-url="/pages/service/service?id={{item.id}}"><view class="row between"><view class="grow"><view class="service-heading">{{item.title}}</view><view class="service-facts">{{item.platformLabel}} · {{item.durationMinutes}}分钟 · {{item.teamSize||1}}位成员</view></view><text class="price">¥{{item.fromPrice}}<text>{{item.variants.length?' 起':'/'+item.unitLabel}}</text></text></view></button></view><view class="section-head"><view class="section-title">选一位队友</view><button class="link" bindtap="navigate" data-url="/pages/players/players">全部成员</button></view><view class="member-grid"><button wx:for="{{players}}" wx:key="id" class="text-button member-tile" bindtap="navigate" data-url="/pages/player/player?id={{item.id}}"><image wx:if="{{item.image}}" class="member-portrait" src="{{item.image}}" mode="aspectFill"/><view wx:else class="member-portrait member-initial">{{item.initials}}</view><view class="strong">{{item.name}}</view><view class="small muted">{{item.role}}</view></button></view><view class="menu-row section-link" bindtap="navigate" data-url="/pages/announcements/announcements"><text>俱乐部公告</text><text class="muted">查看</text></view></block><template is="demo" data="{{demo}}"/></view>
