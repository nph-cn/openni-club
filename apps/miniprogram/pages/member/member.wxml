<import src="../../templates/common.wxml"/>
<view class="page" style="{{themeStyle}}"><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading&&!error}}"><view class="row between"><view class="title">{{me.player.name}}的工作台</view><text class="status" wx:if="{{pending}}">{{pending}} 单待接</text></view><view class="button-row"><button class="button secondary" bindtap="navigate" data-url="/pages/availability/availability">可接时段</button><button class="button secondary" bindtap="navigate" data-url="/pages/earnings/earnings">收入明细</button></view><view class="chips"><button class="chip {{active==='active'?'active':''}}" bindtap="choose" data-value="active">进行中</button><button class="chip {{active==='pending'?'active':''}}" bindtap="choose" data-value="pending">待接单</button><button class="chip {{active==='all'?'active':''}}" bindtap="choose" data-value="all">全部</button></view><button wx:for="{{orders}}" wx:key="id" class="text-button" bindtap="navigate" data-url="/pages/order/order?id={{item.id}}&member=1"><view class="card"><view class="row between"><text class="strong">{{item.serviceTitle}}</text><text class="status">{{item.statusLabel}}</text></view><view class="order-line"><text>{{item.time}}</text><text>{{item.durationMinutes}} 分钟</text></view><view class="divider"></view><view class="row between"><text class="muted">本单预计收入</text><text class="price">¥{{item.income}}</text></view><view wx:if="{{item.acceptBy}}" class="small muted">接单截止 {{item.acceptTime}}</view></view></button><view wx:if="{{!orders.length}}" class="empty"><view class="empty-title">暂无{{active==='pending'?'待接':'进行中的'}}订单</view><button class="button secondary" bindtap="navigate" data-url="/pages/availability/availability">设置可接时段</button></view></block><template is="demo" data="{{demo}}"/></view>
