<import src="../../templates/common.wxml"/>
<view class="page service-page service-detail-page" style="{{themeStyle}}"><template is="state" data="{{loading,error,authRequired,skeletonRows,skeletonKind}}"/><block wx:if="{{!loading&&!error}}"><image wx:if="{{service.coverUrl}}" class="service-card-photo" mode="aspectFill" src="{{service.coverUrl}}"/><view class="title">{{service.title}}</view><view class="row between"><text>{{selected.typeLabel}} · {{selected.durationMinutes}} 分钟</text><text class="price">¥{{selected.price}}<text> / {{selected.unitLabel}}</text></text></view><view wx:if="{{service.variants.length}}" class="section-title">选择规格</view><view wx:if="{{service.variants.length}}" class="slot-grid"><button wx:for="{{service.variants}}" wx:key="id" class="chip {{variantId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="choose">{{item.title}}</button></view><view class="fact-grid"><view wx:if="{{selected.platformLabel}}"><view class="label">设备</view><text>{{selected.platformLabel}}</text></view><view wx:if="{{selected.gameMode}}"><view class="label">玩法</view><text>{{selected.gameMode}}</text></view><view wx:if="{{selected.teamSize}}"><view class="label">服务成员</view><text>{{selected.teamSize}} 位</text></view><view><view class="label">预约时长</view><text>{{selected.durationMinutes}} 分钟</text></view></view><view wx:if="{{selected.maps.length}}" class="service-facts">地图：{{selected.maps}}</view><view class="service-description">{{selected.description}}</view><view wx:if="{{selected.rules.length}}" class="section-title">服务约定</view><view wx:for="{{selected.rules}}" wx:key="*this" class="flow-step">{{item}}</view><view class="section-head"><view class="section-title">服务成员</view><button class="link" bindtap="navigate" data-url="/pages/players/players">查看全部</button></view><view class="card"><view wx:for="{{players}}" wx:key="id" class="menu-row" bindtap="navigate" data-url="/pages/player/player?id={{item.id}}"><view class="row"><image wx:if="{{item.image}}" class="avatar" src="{{item.image}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initials}}</view><view><view class="strong">{{item.name}}</view><view class="small muted">{{item.role}}</view></view></view></view></view><view class="service-bookbar"><button class="button" bindtap="book">选择时间 · ¥{{selected.price}}</button></view></block></view>
