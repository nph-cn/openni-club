# Copy to deploy/.env and replace values before starting. Never commit .env.
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
API_MODE=production
ADMIN_TOKEN=
CORS_ORIGINS=https://api.example.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NATIVE_APP_ID=
WECHAT_NATIVE_APP_SECRET=
WECHAT_PAY_ENABLED=false
WECHAT_NATIVE_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
# Put PEM files inside deploy/secrets; paths below refer to the container.
WECHAT_PAY_PRIVATE_KEY_PATH=/run/openni-secrets/merchant-private-key.pem
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_KEY_PATH=/run/openni-secrets/wechat-platform-public-key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
WECHAT_NATIVE_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat-app/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/refund-notify
WECHAT_NATIVE_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat-app/refund-notify
